# Deterministic fail-closed retrieval gate. Calibrate against your collection before release.
RETRIEVAL_MIN_ENTRIES=2
RETRIEVAL_MIN_TOP_SCORE=10
RETRIEVAL_MIN_TOTAL_SCORE=25
RETRIEVAL_MIN_MATCHED_TERMS=2
RETRIEVAL_MIN_TERM_COVERAGE=0.2
