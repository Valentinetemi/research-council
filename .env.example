SANITY_CONTEXT_MCP_URL=
SANITY_ORGANIZATION_TOKEN=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

HOST=127.0.0.1
PORT=4317
PUBLIC_LIVE_LIMIT=1
